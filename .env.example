# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===========================================
# AUTHENTICATION (Better Auth)
# ===========================================
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="your-secret-here"

# ===========================================
# EMAIL SERVICE (Resend)
# ===========================================
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="re_123456789"

# Sender email (use onboarding@resend.dev for dev, your domain for prod)
RESEND_FROM_EMAIL="StudySpace <onboarding@resend.dev>"

# ===========================================
# PUSHER SERVICE (for real-time updates)
# ===========================================
# Get your credentials from https://dashboard.pusher.com
PUSHER_APP_ID="your-app-id"
PUSHER_SECRET="your-secret"
PUSHER_CLUSTER="eu"

# Public keys (exposed to client)
NEXT_PUBLIC_PUSHER_KEY="your-key"
NEXT_PUBLIC_PUSHER_CLUSTER="eu"
